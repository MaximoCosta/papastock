DATABASE_URL=postgresql://papastock:password@localhost:5432/papastock
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
DATABASE_READINESS_TIMEOUT_MS=1500
PAPASTOCK_AUTH_USERNAME=operador
PAPASTOCK_AUTH_PASSWORD_HASH=
PAPASTOCK_SESSION_SECRET=
# Orígenes extra del SPA (Netlify y Render ya están permitidos por defecto):
# PAPASTOCK_ALLOWED_ORIGINS=https://papstock.netlify.app

# Producción siempre usa el Express same-origin de PapaStock.
# Opt-in exclusivo de desarrollo para probar un backend alternativo:
# VITE_API_BASE_URL=http://localhost:8080

# Forzar snapshot mock del frontend (sin llamar a la API):
# VITE_DATA_SOURCE=mock
